<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Spring's rules, the set Spring Boot applies to its own code, and the size
     limits of GATool. Spring's files leave sizes to review, so the three limits
     are GATool's, chosen at values that almost all of Spring Boot's, Spring AI's
     and Spring for GraphQL's code is inside. -->
<module name="com.puppycrawl.tools.checkstyle.Checker">
	<module name="SuppressionFilter">
		<property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
	</module>
	<module name="io.spring.javaformat.checkstyle.SpringChecks">
		<property name="headerFile" value="${config_loc}/checkstyle-header.txt"/>
		<property name="projectRootPackage" value="io.gatool"/>
	</module>
	<!-- A file holds at most 1,000 lines. -->
	<module name="FileLength">
		<property name="max" value="1000"/>
		<property name="fileExtensions" value="java"/>
	</module>
	<module name="com.puppycrawl.tools.checkstyle.TreeWalker">
		<!-- A method or a constructor takes at most 7 parameters. A value type
		     with more than that is built through a builder. -->
		<module name="ParameterNumber">
			<property name="max" value="7"/>
			<property name="tokens" value="METHOD_DEF, CTOR_DEF"/>
		</module>
		<!-- A record declares at most 7 components, which is its constructor. -->
		<module name="RecordComponentNumber">
			<property name="max" value="7"/>
		</module>
		<!-- A method or a constructor is at most 60 lines, comments included. -->
		<module name="MethodLength">
			<property name="max" value="60"/>
			<property name="tokens" value="METHOD_DEF, CTOR_DEF, COMPACT_CTOR_DEF"/>
		</module>
	</module>
</module>
